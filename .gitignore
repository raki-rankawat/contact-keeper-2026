# Dependencies
node_modules/
.pnp
.pnp.js

# Environment / secrets
.env
.env.*
!.env.example

# Build output
build/
dist/
client/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test coverage
coverage/
*.lcov
.nyc_output/

# Caches
.npm
.eslintcache
.cache/
.parcel-cache/

# Editors
# Shared workspace config is tracked so a fresh clone needs no setup; anything
# else under .vscode/ is personal and stays ignored.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Claude Code local settings (project skills stay tracked)
.claude/settings.local.json

# graphify build artifacts (regenerated by /graphify; the report stays tracked)
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Playwright MCP page snapshots and console logs — test artifacts, not source
.playwright-mcp/

# Client
/client/build

.DS_Store
/client/.env.local
/client/.env.development.local
/client/.env.test.local
/client/.env.production.local